manifest {
    name = "Rob Syme test template"
}

profiles {
    simpleParam {
        // In this approach, we assume that the s3_output_directory param includes the full path including process name - we'll attach configuration that sets the parameter to the pipeline in the launchpad
        process.publishDir = { "${params.s3_output_directory}/${task.process}"}
    }
    processDirective {    
        // In this approach, we assume that the s3_output_base param includes only the base path - we'll build the rest of the path dynamically here. This avoids the need to set different params for each repo in the launchpad, but is a bit more complex
        process.publishDir = {
            def repo = workflow.repository?.tokenize("/")[-2..-1]?.join("/") ?: "default-repo"
            "${params.s3_output_base}/${repo}/${new Date().format('yyyy-MM-dd')}/${task.process}"
        }
    }
}

params {
    s3_output_directory = 's3://default-directory/results/example/repo'
    s3_output_base = 's3://default-directory/results'
}

process.container = 'quay.io/nextflow/bash'